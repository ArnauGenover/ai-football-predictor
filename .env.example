# ═══════════════════════════════════════════════════════════
# Football Analytics Platform — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── Database: Neon PostgreSQL (production / collector) ───
# Sync driver (used by collector + Alembic)
DATABASE_URL_SYNC=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require
# Async driver (used by FastAPI backend in production)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?ssl=require

# ─── Database: Local Docker (development) ───
POSTGRES_USER=football
POSTGRES_PASSWORD=football_secret
POSTGRES_DB=football_analytics
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── API-Football ───
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# ─── Target Leagues (comma-separated IDs) ───
# 39=Premier League, 140=La Liga, 135=Serie A, 78=Bundesliga, 61=Ligue 1
TARGET_LEAGUE_IDS=39,140,135,78,61
CURRENT_SEASON=2025

# ─── Backend ───
BACKEND_PORT=7860
BACKEND_HOST=0.0.0.0
ENVIRONMENT=development

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:7860

# ─── Hugging Face (set after deploying backend) ───
HF_SPACE_URL=https://your-username-football-api.hf.space
