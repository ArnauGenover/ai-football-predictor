# ─── Database (Neon PostgreSQL — sync driver for collector) ───
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_SYNC=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# ─── API-Football ───
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# ─── Target leagues (comma-separated API-Football league IDs) ───
# 39=Premier League, 140=La Liga, 135=Serie A, 78=Bundesliga, 61=Ligue 1
TARGET_LEAGUE_IDS=39,140,135,78,61

# ─── Season year (the year the season started) ───
CURRENT_SEASON=2025

# ─── Hugging Face Space keep-alive URL (set after deployment) ───
HF_SPACE_URL=
